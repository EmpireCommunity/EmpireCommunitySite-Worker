{
  "name": "empirecommunitysite-worker",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:config": "node scripts/check-config.ts",
    "build": "pnpm check:config && wrangler deploy --config wrangler.jsonc --dry-run --outdir dist",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "check:workflows": "node scripts/check-workflows.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261108.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.14.0",
    "jsonc-parser": "3.3.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "wrangler": "4.158.0",
    "yaml": "2.9.1"
  }
}
